{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
      "builder": "NIXPACKS",
      "buildCommand": "pip install -r ev-app/backend/requirements.txt"
    },
    "deploy": {
      "startCommand": "cd ev-app/backend && uvicorn main:app --host 0.0.0.0 --port $PORT",
      "restartPolicyType": "ON_FAILURE"
    }
  }